#selectionRow.row.mx-auto
  div.ms-1.mt-4.row
    - (1..5).each do |num|
      button.col.btn.btn-primary.me-2 type="button" data-action="click->board#makeSelection" id="select_#{num}"
        | #{num}
  div.ms-1.mt-1.row
    - (6..9).each do |num|
      button.col.btn.btn-primary.me-2 type="button" data-action="click->board#makeSelection" id="select_#{num}"
        | #{num}
    button.col.btn.btn-outline-danger.me-2 type="button" data-action="click->board#clearButtonClick" id="clear_square"
      | X
  div.ms-1.mt-3.row
    button.col.btn.btn-outline-secondary.me-2 type="button" id="toggle_edit_mode" data-board-target="editToggle" data-action="click->board#toggleEditMode"
      i.bi.bi-pencil
      span.editModeLabel.ms-2 Notes: Off
