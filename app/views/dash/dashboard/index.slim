h1.h3.mb-4 Overview

.row.g-3.mb-4
  .col-6.col-md-3
    .card.text-center.h-100
      .card-body
        .display-6 = @total_matches
        .text-muted.small Total matches
  .col-6.col-md-3
    .card.text-center.h-100
      .card-body
        .display-6 = @completed_matches
        .text-muted.small Completed (#{@completion_rate}%)
  .col-6.col-md-3
    .card.text-center.h-100
      .card-body
        .display-6 = @unique_visitors
        .text-muted.small Unique visitors
  .col-6.col-md-3
    .card.text-center.h-100
      .card-body
        .display-6 = @total_visits
        .text-muted.small Total visits

.row.g-3.mb-4
  .col-md-4
    .card.h-100
      .card-header Matches over time
      ul.list-group.list-group-flush
        li.list-group-item.d-flex.justify-content-between
          span Last 24 hours
          strong = @matches_24h
        li.list-group-item.d-flex.justify-content-between
          span Last 7 days
          strong = @matches_7d
        li.list-group-item.d-flex.justify-content-between
          span Last 30 days
          strong = @matches_30d

  .col-md-4
    .card.h-100
      .card-header Difficulty breakdown
      - if @difficulty_breakdown.empty?
        .card-body.text-muted No matches yet.
      - else
        ul.list-group.list-group-flush
          - @difficulty_breakdown.each do |level, count|
            li.list-group-item.d-flex.justify-content-between
              span = level.to_s.titleize
              strong = count

  .col-md-4
    .card.h-100
      .card-header Top countries
      - if @top_countries.empty?
        .card-body.text-muted
          | No locations resolved yet.
          br
          small.text-muted Open a match to geocode its players, or run rake dash:backfill_geocodes.
      - else
        ul.list-group.list-group-flush
          - @top_countries.each do |country, count|
            li.list-group-item.d-flex.justify-content-between
              span = country
              strong = count

.card
  .card-header.d-flex.justify-content-between.align-items-center
    span Recent matches
    a.btn.btn-sm.btn-outline-secondary href=dash_matches_path View all
  .table-responsive
    table.table.table-hover.mb-0
      thead
        tr
          th Created
          th Players
          th Difficulty
          th Status
      tbody
        - if @recent_matches.empty?
          tr
            td colspan="4" class="text-muted text-center" No matches yet.
        - @recent_matches.each do |match|
          tr role="button" onclick="window.location='#{dash_match_path(match)}'"
            td = dash_time(match.created_at)
            td
              | #{match.player_1_name || "—"} vs #{match.player_2_name || "—"}
            td = match.difficulty_level&.titleize
            td = match_status_badge(match)
