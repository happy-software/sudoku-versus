doctype html
html lang="en"
  head
    title SudokuVersus · Admin
    meta name="viewport" content="width=device-width,initial-scale=1"
    meta name="robots" content="noindex, nofollow"
    = csrf_meta_tag
    = csp_meta_tag

    = stylesheet_link_tag "application", "data-turbo-track": "reload"
    = javascript_include_tag "application", "data-turbo-track": "reload", defer: true

  body
    nav.navbar.navbar-expand-lg.navbar-dark.bg-dark.mb-3
      .container-fluid
        a.navbar-brand href=dash_root_path SudokuVersus Admin
        ul.navbar-nav.me-auto.mb-2.mb-lg-0.flex-row
          li.nav-item.me-3
            a.nav-link href=dash_root_path Overview
          li.nav-item.me-3
            a.nav-link href=dash_matches_path Matches
        a.nav-link.text-light.ms-auto href=root_path target="_blank" View site →

    .container
      = yield
